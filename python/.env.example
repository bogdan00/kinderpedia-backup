# Copy this file to `.env` and restrict permissions (`chmod 600 .env`).
# Never commit `.env` to version control!
#
# Tip: If you run `kinderpedia-backup` interactively in a terminal, you don't
# even need a `.env` file — it will prompt securely for your email/password once
# and store a 0600 session token in `~/.config/kinderpedia-backup/session.json`.

KINDERPEDIA_EMAIL=parent@example.com
KINDERPEDIA_PASSWORD=
# Optional default output folder (defaults to ~/kinderpedia_bk):
# KINDERPEDIA_OUTPUT=~/kinderpedia_bk
